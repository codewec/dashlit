ADDR=:8080
DATA_DIR=./data
JWT_SECRET=replace-with-a-long-random-secret
DEV_MODE=false

# Leave both empty to disable OIDC.
OIDC_ISSUER=https://id.example.com
OIDC_CLIENT_ID=dashlit
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URL=http://localhost:8080/api/auth/oidc/callback
OIDC_BUTTON_TITLE=Sign in with Pocket ID

# Password registration and OIDC user creation are separate policies.
DISABLE_PASSWORD_REGISTRATION=false
DISABLE_OIDC_REGISTRATION=false

# Applied only when OIDC_ISSUER and OIDC_CLIENT_ID are configured.
DISABLE_PASSWORD_LOGIN=false
